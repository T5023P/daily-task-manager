rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user data isolation: each user can only access their own subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Daily tasks subcollection
      match /dailyTasks/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Long-term orders subcollection
      match /longTermOrders/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Phone verification collection (used during signup)
    match /phones/{phoneNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
