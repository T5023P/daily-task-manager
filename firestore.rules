rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

    // Root collections for admin users
    match /dailyTasks/{document=**} {
      allow read, write: if request.auth != null && 
        (request.auth.token.email.toLowerCase() == "topsecuritieslko@gmail.com" || 
         request.auth.token.email.toLowerCase() == "arsh5023siddiqui@gmail.com");
    }

    match /longTermOrders/{document=**} {
      allow read, write: if request.auth != null && 
        (request.auth.token.email.toLowerCase() == "topsecuritieslko@gmail.com" || 
         request.auth.token.email.toLowerCase() == "arsh5023siddiqui@gmail.com");
    }

    // Per-user data isolation for normal users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Daily tasks subcollection
      match /dailyTasks/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Long-term orders subcollection
      match /longTermOrders/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Phone verification collection
    match /phones/{phoneNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
