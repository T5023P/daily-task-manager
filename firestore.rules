rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin shared data (top-level collections)
    match /dailyTasks/{taskId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['topsecuritieslko@gmail.com', 'arsh5023siddiqui@gmail.com'];
    }
    match /longTermOrders/{orderId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['topsecuritieslko@gmail.com', 'arsh5023siddiqui@gmail.com'];
    }
    match /outstandingCollections/{itemId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['topsecuritieslko@gmail.com', 'arsh5023siddiqui@gmail.com'];
    }
    match /taskListSettings/{settingsId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['topsecuritieslko@gmail.com', 'arsh5023siddiqui@gmail.com'];
    }

    // Per-user private data (regular users)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Phone verification tracking
    match /phones/{phoneNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
